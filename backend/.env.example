# ─── ResearchHub AI — Backend Environment Variables ──────────────────────────
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.
#
# Get your free Groq API key at: https://console.groq.com/keys

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For Render + Vercel deployment, add your Vercel URL here:
#   ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# All *.vercel.app subdomains are ALSO allowed automatically via regex.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for local dev (uses ./sql_app.db)
# Render sets this to /data automatically via render.yaml
# DB_DIR=/data
